# Copier ce fichier en `.env.local` puis compléter les valeurs.

# --- Supabase (CMS / base de données) -------------------------------------
# Clés "publishable" et URL du projet. Elles sont publiques côté navigateur :
# la sécurité repose sur les policies RLS, jamais sur le secret de ces clés.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Domaine public du site -----------------------------------------------
# Utilisé pour les URL canoniques, le sitemap, robots.txt et les partages.
# Ex. https://www.cslaprovidence.org
VITE_SITE_URL=
